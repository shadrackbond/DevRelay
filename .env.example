# Copy this file to apps/web/.env.local, then restart the web server.
# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Model provider
AI_PROVIDER=mock
AI_API_KEY=

# GitHub Repository Agent
# Optional for public repositories; required for private repos and recommended for higher API rate limits.
GITHUB_TOKEN=

# Investigation/audit history (SQLite; default .data/devrelay.sqlite in the web working directory)
# Use an absolute path on a persistent volume in deployments.
DEVRELAY_DB_PATH=

# Database Agent
# Read-only telemetry endpoint that exposes PostgreSQL health metrics.
# For simulated checkout evidence instead, set DB_TELEMETRY_URL=simulated://checkout.
DB_TELEMETRY_URL=
# Optional bearer token for the telemetry endpoint.
DB_TELEMETRY_TOKEN=

# Runtime Log Agent
# Read-only HTTP endpoint. Expected query params: service, from, to, limit.
# For simulated checkout evidence instead, set LOG_SOURCE_URL=simulated://checkout.
LOG_SOURCE_URL=
# Optional bearer token sent only from the server runtime.
LOG_SOURCE_TOKEN=

# Optional observability / integrations
SENTRY_DSN=
