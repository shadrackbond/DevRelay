{
  "name": "devrelay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @devrelay/web dev",
    "build": "pnpm -r build",
    "check:demo": "pnpm --filter @devrelay/core check:demo",
    "check:github": "node scripts/check-github-adapter.mjs",
    "check:simulated": "node scripts/check-simulated-providers.mjs",
    "check:reasoning": "node scripts/check-reasoning-agent.mjs",
    "check:approval": "node scripts/check-approval-gate.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  }
}
